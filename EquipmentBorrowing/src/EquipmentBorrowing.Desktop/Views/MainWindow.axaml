<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Campus Equipment Borrowing System">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="180,*">

        <!-- Sidebar -->
        <StackPanel Grid.Column="0"
                    Background="#2D2D30"
                    Spacing="8"
                    Margin="0">
            <TextBlock Text="Campus Borrowing"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="16,20,16,20" />

            <Button Content="Equipment"
                    Command="{Binding ShowEquipmentCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,8,0" />

            <Button Content="Active Borrowings"
                    Command="{Binding ShowBorrowingsCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,8,0" />
        </StackPanel>

        <!-- Content area -->
        <ContentControl Grid.Column="1"
                         Content="{Binding CurrentView}"
                         Margin="20" />

    </Grid>

</Window>