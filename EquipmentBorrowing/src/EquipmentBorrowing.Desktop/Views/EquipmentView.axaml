<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10">
        <TextBlock Text="Available Equipment" Classes="Heading" />

        <ListBox ItemsSource="{Binding EquipmentList}"
                 SelectedItem="{Binding SelectedEquipment}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="ItemCard">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding EquipmentId, StringFormat='ID: {0}'}" />
                            <TextBlock Text="{Binding Type, StringFormat='Type: {0}'}" />
                            <TextBlock Text="{Binding IsActivelyBorrowed, StringFormat='Borrowed: {0}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Border Classes="Card">
    <StackPanel Spacing="8">
        <TextBlock Text="Register Student" Classes="SectionLabel" />

        <TextBlock Text="Institutional number:" />
        <TextBox Text="{Binding StudentIdInput}"
                 PlaceholderText="Enter student number" />

        <TextBlock Text="Full name:" />
        <TextBox Text="{Binding StudentNameInput}"
                 PlaceholderText="Enter full name" />

        <TextBlock Text="Contact (optional):" />
        <TextBox Text="{Binding StudentContactInput}"
                 PlaceholderText="Enter contact information" />

        <Button Content="Register Student"
                Command="{Binding RegisterStudentCommand}"
                HorizontalAlignment="Left" />
    </StackPanel>
    </Border>
        <Border Classes="Card">
    <StackPanel Spacing="8">
        <TextBlock Text="Update Student" Classes="SectionLabel" />

        <TextBlock Text="Select student:" />
        <ComboBox ItemsSource="{Binding StudentList}"
                  SelectedItem="{Binding SelectedStudentForUpdate}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Institutional number:" />
<TextBox Text="{Binding StudentUpdateIdInput}"
         PlaceholderText="Enter institutional number" />
        <TextBlock Text="Full name:" />
        <TextBox Text="{Binding StudentUpdateNameInput}"
                 PlaceholderText="Enter full name" />

        <TextBlock Text="Program (optional):" />
        <TextBox Text="{Binding StudentUpdateProgramInput}"
                 PlaceholderText="Enter program" />

        <TextBlock Text="Contact (optional):" />
        <TextBox Text="{Binding StudentUpdateContactInput}"
                 PlaceholderText="Enter contact information" />
        <CheckBox Content="Authorized to borrow equipment"
          IsChecked="{Binding StudentUpdateIsAuthorizedInput}" />
        <Button Content="Update Student"
                Command="{Binding UpdateStudentCommand}"
                HorizontalAlignment="Left" />
    </StackPanel>
</Border>
        <Border Classes="Card">
    <StackPanel Spacing="8">
        <TextBlock Text="Register Equipment" Classes="SectionLabel" />

        <TextBlock Text="Equipment ID:" />
        <TextBox Text="{Binding EquipmentIdInput}"
                 PlaceholderText="Enter equipment ID" />

        <TextBlock Text="Name:" />
        <TextBox Text="{Binding EquipmentNameInput}"
                 PlaceholderText="Enter equipment name" />

        <TextBlock Text="Description (optional):" />
        <TextBox Text="{Binding EquipmentDescriptionInput}"
                 PlaceholderText="Enter description" />

        <Button Content="Register Equipment"
                Command="{Binding RegisterEquipmentCommand}"
                HorizontalAlignment="Left" />
    </StackPanel>
</Border>
        <Border Classes="Card">
    <StackPanel Spacing="8">
        <TextBlock Text="Update Selected Equipment" Classes="SectionLabel" />
        <TextBlock Text="Select an equipment item in the list above, then edit its details." />
        <TextBlock Text="Equipment ID:" />
<TextBox Text="{Binding EquipmentUpdateIdInput}"
         PlaceholderText="Enter equipment ID" />
        <TextBlock Text="Name:" />
        <TextBox Text="{Binding EquipmentUpdateNameInput}"
                 PlaceholderText="Enter equipment name" />

        <TextBlock Text="Description (optional):" />
        <TextBox Text="{Binding EquipmentUpdateDescriptionInput}"
                 PlaceholderText="Enter description" />

        <Button Content="Update Equipment"
                Command="{Binding UpdateEquipmentCommand}"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding EquipmentUpdateStatusMessage}"
           Classes="StatusMessage" />
    </StackPanel>
</Border>
        <Border Classes="Card">
    <StackPanel Spacing="8">
        <TextBlock Text="Check Out Multiple Equipment Items"
                   Classes="SectionLabel" />

        <TextBlock Text="Student:" />
        <ComboBox ItemsSource="{Binding StudentList}"
                  SelectedItem="{Binding SelectedCheckoutStudent}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Select at least two available items:" />
        <ItemsControl ItemsSource="{Binding CheckoutEquipmentOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}"
                              IsChecked="{Binding IsSelected}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Expected return date:" />
        <DatePicker SelectedDate="{Binding ExpectedReturnDateInput}" />

        <Button Content="Check Out Selected Items"
                Command="{Binding CheckoutMultipleCommand}"
                HorizontalAlignment="Left" />

        <TextBlock Text="{Binding MultiCheckoutStatusMessage}"
                   Classes="StatusMessage" />
    </StackPanel>
</Border>
        <Border Classes="Card" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Borrow Selected Equipment" Classes="SectionLabel" />

                <TextBlock Text="Student:" />
                <ComboBox ItemsSource="{Binding StudentList}"
                          SelectedItem="{Binding SelectedStudent}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="Borrow Equipment"
                        Command="{Binding BorrowCommand}"
                        HorizontalAlignment="Left" />

                <TextBlock Text="{Binding BorrowStatusMessage}" Classes="StatusMessage" />
            </StackPanel>
        </Border>
        </StackPanel>
</ScrollViewer>


</UserControl>