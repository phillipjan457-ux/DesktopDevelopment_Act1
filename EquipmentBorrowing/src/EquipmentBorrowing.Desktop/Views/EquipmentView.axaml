<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <StackPanel Spacing="10">
        <TextBlock Text="Available Equipment" FontSize="20" FontWeight="Bold" />

        <ListBox ItemsSource="{Binding EquipmentList}"
                 SelectedItem="{Binding SelectedEquipment}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding EquipmentId, StringFormat='ID: {0}'}" />
                            <TextBlock Text="{Binding Type, StringFormat='Type: {0}'}" />
                            <TextBlock Text="{Binding IsActivelyBorrowed, StringFormat='Borrowed: {0}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Borrow Selected Equipment" FontWeight="Bold" />

                <TextBlock Text="Student:" />
                <ComboBox ItemsSource="{Binding StudentList}"
                          SelectedItem="{Binding SelectedStudent}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="Borrow Equipment"
                        Command="{Binding BorrowCommand}"
                        HorizontalAlignment="Left" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Orange"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>