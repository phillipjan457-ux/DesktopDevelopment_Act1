<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <StackPanel Spacing="10">
        <TextBlock Text="Active Borrowings" FontSize="20" FontWeight="Bold" />

        <ListBox ItemsSource="{Binding ActiveBorrowings}"
                 SelectedItem="{Binding SelectedBorrowing}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Equipment.Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Student.Name, StringFormat='Borrowed by: {0}'}" />
                            <TextBlock Text="{Binding BorrowDate, StringFormat='Borrowed: {0:d}'}" />
                            <TextBlock Text="{Binding ReturnDate, StringFormat='Due: {0:d}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Return Selected Borrowing" FontWeight="Bold" />

                <Button Content="Return Equipment"
                        Command="{Binding ReturnCommand}"
                        HorizontalAlignment="Left" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Orange"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>