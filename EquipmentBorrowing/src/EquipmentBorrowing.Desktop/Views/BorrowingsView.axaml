<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="10">
        <TextBlock Text="Active Borrowings" Classes="Heading" />

        <ListBox ItemsSource="{Binding ActiveBorrowings}"
                 SelectedItem="{Binding SelectedBorrowing}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="ItemCard">
                        <StackPanel>
                            <TextBlock Text="{Binding Equipment.Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Student.Name, StringFormat='Borrowed by: {0}'}" />
                            <TextBlock Text="{Binding BorrowDate, StringFormat='Borrowed: {0:d}'}" />
                            <TextBlock Text="{Binding ReturnDate, StringFormat='Due: {0:d}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Classes="Card" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Return Selected Borrowing" Classes="SectionLabel" />

                <Button Content="Return Equipment"
                        Command="{Binding ReturnCommand}"
                        HorizontalAlignment="Left" />

                <TextBlock Text="{Binding StatusMessage}" Classes="StatusMessage" />
            </StackPanel>
        </Border>
        <Border Classes="Card" Margin="0,10,0,0">
    <StackPanel Spacing="8">
        <TextBlock Text="Student Borrowing History"
                   Classes="SectionLabel" />

        <TextBlock Text="Select student:" />
        <ComboBox ItemsSource="{Binding StudentList}"
                  SelectedItem="{Binding SelectedHistoryStudent}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Content="Show Student History"
                Command="{Binding LoadStudentHistoryCommand}"
                HorizontalAlignment="Left" />

        <TextBlock Text="{Binding HistoryStatusMessage}"
                   Classes="StatusMessage" />
        <Border Classes="Card" Margin="0,10,0,0">
    <StackPanel Spacing="8">
        <TextBlock Text="Search Borrowings"
                   Classes="SectionLabel" />

        <TextBlock Text="Search by student, equipment, or borrowing ID:" />
        <TextBox Text="{Binding BorrowingSearchText}"
                 PlaceholderText="Enter a name or ID" />

        <TextBlock Text="Status:" />
        <ComboBox ItemsSource="{Binding BorrowingStatusOptions}"
                  SelectedItem="{Binding SelectedBorrowingStatusFilter}" />

        <TextBlock Text="Sort by:" />
        <ComboBox ItemsSource="{Binding BorrowingSortOptions}"
                  SelectedItem="{Binding SelectedBorrowingSort}" />

        <Button Content="Search Borrowings"
                Command="{Binding SearchBorrowingsCommand}"
                HorizontalAlignment="Left" />

        <TextBlock Text="{Binding BorrowingSearchStatus}"
                   Classes="StatusMessage" />

        <ListBox ItemsSource="{Binding BorrowingSearchResults}"
                 MaxHeight="300"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="ItemCard">
                        <StackPanel>
                            <TextBlock Text="{Binding Equipment.Name}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding Student.Name, StringFormat='Student: {0}'}" />
                            <TextBlock Text="{Binding BorrowDate, StringFormat='Borrowed: {0:d}'}" />
                            <TextBlock Text="{Binding ReturnDate, StringFormat='Due: {0:d}'}" />
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Border>
        <ListBox ItemsSource="{Binding StudentBorrowingHistory}"
                 MaxHeight="300"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="ItemCard">
                        <StackPanel>
                            <TextBlock Text="{Binding Equipment.Name}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding BorrowDate, StringFormat='Borrowed: {0:d}'}" />
                            <TextBlock Text="{Binding ReturnDate, StringFormat='Due: {0:d}'}" />
                            <TextBlock Text="{Binding ReturnedAt, StringFormat='Returned: {0:d}'}" />
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Border>
        <Border Classes="Card" Margin="0,10,0,0">
    <StackPanel Spacing="8">
        <TextBlock Text="Equipment Borrowing History"
                   Classes="SectionLabel" />

        <TextBlock Text="Select equipment:" />
        <ComboBox ItemsSource="{Binding EquipmentList}"
                  SelectedItem="{Binding SelectedHistoryEquipment}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Content="Show Equipment History"
                Command="{Binding LoadEquipmentHistoryCommand}"
                HorizontalAlignment="Left" />

        <TextBlock Text="{Binding EquipmentHistoryStatusMessage}"
                   Classes="StatusMessage" />

        <ListBox ItemsSource="{Binding EquipmentBorrowingHistory}"
                 MaxHeight="300"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="ItemCard">
                        <StackPanel>
                            <TextBlock Text="{Binding Student.Name}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding BorrowDate, StringFormat='Borrowed: {0:d}'}" />
                            <TextBlock Text="{Binding ReturnDate, StringFormat='Due: {0:d}'}" />
                            <TextBlock Text="{Binding ReturnedAt, StringFormat='Returned: {0:d}'}" />
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>