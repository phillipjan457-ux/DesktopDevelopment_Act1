<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.Desktop.ViewModels"
        xmlns:domain="using:CareFlow.Domain"
        xmlns:app="using:CareFlow.Application"
        x:Class="CareFlow.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CareFlow Diagnostic Booking" Width="980" Height="760" MinWidth="760" MinHeight="600">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="CareFlow" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="Diagnostic Booking Management" FontSize="16" />
      <Border Padding="16" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="10">
          <TextBlock Text="New diagnostic booking" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="Patient" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" PlaceholderText="Select an existing patient">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="domain:Patient"><TextBlock Text="{Binding FullName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Booking date" FontWeight="SemiBold" />
          <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
          <Button Content="Refresh availability" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="Choose 1–3 different services. Capacity is checked again when you confirm." TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding AvailableServices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ServiceChoice">
                <Border Padding="10" Margin="0,3" BorderBrush="#888" BorderThickness="1" CornerRadius="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Remaining, StringFormat='Remaining: {0}'}" VerticalAlignment="Center" Margin="16,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Confirm Booking" Command="{Binding ConfirmCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Padding="16" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Confirmed bookings" FontSize="20" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding Bookings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:BookingSummary">
                <Border Padding="10" Margin="0,3" BorderBrush="#888" BorderThickness="1" CornerRadius="4">
                  <StackPanel>
                    <TextBlock Text="{Binding PatientName}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Date, StringFormat='Date: {0}'}" />
                    <TextBlock Text="{Binding ServicesText, StringFormat='Services: {0}'}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <TextBlock Text="Sample patient names are fictional." Opacity="0.7" />
    </StackPanel>
  </ScrollViewer>
</Window>
